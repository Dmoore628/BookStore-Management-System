# Copy to .env and replace every value before running locally.
# Never commit a real .env file. Every value below is configuration, not a code constant.

APP_NAME=Ledger & Spine
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite for laptop/dev. Staging/production use PostgreSQL (Neon).
# Example Postgres: postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./bookstore_dev.db

# Use a long random string in every deployed environment (>= 32 chars).
SECRET_KEY=replace-with-a-64-character-random-string

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# Store policy, not a code constant. Tax in basis points: 725 = 7.25%.
TAX_RATE_BPS=725

# IANA timezone used for "today's sales" bucketing (server clock is UTC).
STORE_TZ=America/Denver
CURRENCY=USD

# Backup destination URI. dev: file://./backups  |  prod: blob:// or neon://
BACKUP_DESTINATION=file://./backups

# Session cookie policy.
SESSION_COOKIE_NAME=ls_session
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800

# First owner account, created only when the users table is empty.
INITIAL_OWNER_USERNAME=damian
INITIAL_OWNER_PASSWORD=replace-with-a-strong-password

# Demo staff created by scripts/seed.py. Change after first login.
SEED_MANAGER_USERNAME=richard
SEED_MANAGER_PASSWORD=ChangeMeRichard1
SEED_CASHIER_USERNAME=stephen
SEED_CASHIER_PASSWORD=ChangeMeStephen1

# Container Postgres (docker compose dev).
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
